% Example: "D. W. Arning et al. Mixed Mode--Mixed Level Circuit Simulator.
% (2011). Ngspice. Accessed: Jan. 11, 2019. [Online]. Available: http://..."
% Repository or archive in organization, publisher in publisher.
\DeclareBibliographyDriver{software}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/editor+others/translator+others}%
  \setunit{\adddot\addspace}\newblock
  \usebibmacro{title-in-maintitle}%
