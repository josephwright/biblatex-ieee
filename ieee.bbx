% Example: "Special Issue on Artificial Neural Network Applications, Proc. IEEE,
% vol. 84, pp. 1353--1576, Oct. 1996."
% A virtual journal ("entrysubtype = {virtual}") quotes its issue title:
% Example: "T. Robertson, Ed., “RFIC Virtual Journal--Issue 6,” in IEEE RFIC
% Virtual Journal, Oct. 2014. [Online]. Available: http://..."
\DeclareBibliographyDriver{periodical}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{editor}%
  \setunit{\labelnamepunct}\newblock
  \iffieldundef{issuetitle}
    {}
    {%
      \iffieldequalstr{entrysubtype}{virtual}
        {%
          \printtext{\mkbibquote{\printfield[titlecase]{issuetitle}\isdot}}%
          \setunit{\addcomma\space}%
          \usebibmacro{in:}%
        }
        {\printfield[titlecase]{issuetitle}}%
      \clearfield{issuetitle}%
      \newunit
    }%
  \usebibmacro{periodical}%
  \newunit
  \printlist{language}%
  \newunit\newblock
  \usebibmacro{byeditor}%
  \newunit\newblock
  \printfield{series}%
  \newunit\newblock
  \usebibmacro{volume+number}%
  \newunit\newblock
  \usebibmacro{pages}%
  \newunit\newblock
  \printlist{organization}%
  \newunit\newblock
  \usebibmacro{issue+date}%
  \newunit\newblock
  \printfield{note}%
  \newunit\newblock
  \iftoggle{bbx:isbn}
    {\printfield{issn}}
    {}%
  \newunit\newblock
