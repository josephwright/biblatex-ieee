  \iffieldundef{year}
    {}
    {\printtext[parens]{\usebibmacro{date}}}%
  \setunit{\adddot\addspace}\newblock
  \printlist{organization}%
  \setunit{\adddot\addspace}%
  \iffieldundef{version}
    {}
    {\printtext[parens]{\printfield{version}}}%
  \setunit{\adddot\addspace}\newblock
  \printlist{publisher}%
  \setunit{\adddot\addspace}\newblock
  % "Accessed date. DOI. [Online]. Available: URL" (IEEE Reference Guide, III)
  \usebibmacro{urldate}%
  \setunit{\adddot\addspace}%
  \iftoggle{bbx:doi}
    {\printfield{doi}}
    {}%
  \setunit{\adddot\addspace}%
