% Example: "U.S. Department of Health and Human Services, Aug. 2013, “Treatment
% Episode Dataset: ...,” U.S. Department of ..., doi: 10.3886/ICPSR30122.v2."
\DeclareBibliographyDriver{dataset}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/editor+others/translator+others}%
  \newunit
  \usebibmacro{date}%
  \newunit\newblock
  \printtext[title]{\printfield[titlecase]{title}}%
  \newunit
  \printlist{language}%
  \newunit
  \printfield{version}%
  \newunit\newblock
  \printlist{publisher}%
  \newunit
  \printlist{organization}%
  \newunit\newblock
  \printfield{note}%
  \newunit\newblock
  \setunit{\addcomma\space}%
  \iftoggle{bbx:doi}
    {\printfield{doi}}
    {}%
  \iftoggle{bbx:url}
    {%
