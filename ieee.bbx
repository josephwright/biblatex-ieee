\DeclareBibliographyDriver{inproceedings}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/translator+others}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \newunit
  \printlist{language}%
  \newunit\newblock
  \usebibmacro{byauthor}%
  \newunit\newblock
  \usebibmacro{maintitle+booktitle(inproceedings)}%
  \midsentence
  \newunit\newblock
  \usebibmacro{event+venue+date}%
  \newunit\newblock
  % Example: "in Proc. 7th Eur. Conf. Artif. Life, P. Dittrich and J. T. Kim,
  % Eds. Sep. 2003, pp. 76--89."
  \ifnameundef{editor}
    {\togglefalse{bbx:inproceedings:editor}}
    {\toggletrue{bbx:inproceedings:editor}}%
  \usebibmacro{byeditor+others}%
  \newunit\newblock
  \printfield{volumes}%
  \newunit\newblock
  \printfield{series}%
  \newunit\newblock
  \printfield{note}%
  \newunit\newblock
  \printlist{organization}%
  \newunit\newblock
  % Example: "in IEDM Tech. Dig., 1993, vol. 2, no. 8, pp. 6--13."
  % Example: "in Proc. ..., in Slot Ring Antennas II, vol. 3, 2nd ed., Jul. 2006"
  % Example: "Proc. AFIPS Conf., vol. 29. Washington, DC, USA: Spartan, 1991"
  \ifboolexpr{
    togl {bbx:inproceedings:editor}
    and test {\iffieldundef{volumes}}
    and test {\iffieldundef{series}}
    and test {\iffieldundef{note}}
    and test {\iflistundef{organization}}
  }
    {\setunit{\addspace}}
    {}%
  \ifboolexpr{
    test {\iflistundef{publisher}}
    and
    test {\iffieldundef{maintitle}}
  }
    {%
      \usebibmacro{publisher+location+date}%
      \newunit
      \usebibmacro{volume+number+edition(inproceedings)}%
    }
    {%
      \usebibmacro{volume+number+edition(inproceedings)}%
      \iflistundef{publisher}
        {\newunit}
        {\setunit{\adddot\addspace}}%
      \usebibmacro{publisher+location+date}%
    }%
  \newunit\newblock
  \usebibmacro{chapter+pages}%
  \newunit\newblock
  \iftoggle{bbx:isbn}
    {\printfield{isbn}}
    {}%
  \newunit\newblock
  \usebibmacro{doi+eprint+url}%
  \newunit\newblock
  \usebibmacro{addendum+pubstate}%
  \setunit{\bibpagerefpunct}\newblock
  \usebibmacro{pageref}%
  \newunit\newblock
  \iftoggle{bbx:related}
    {\usebibmacro{related:init}%
     \usebibmacro{related}}
    {}%
  \usebibmacro{finentry}}

% Example: "J. A. Taylor. (Nov. 2006). “Assessment: ...” Presented at Engaging
% Students: ... Conf., Griffith, Australia. [Online]. Available: http://..."
% Example: "J. Smith. “Obama inaugurated as President.” CNN.com. Accessed: ..."
\DeclareBibliographyDriver{online}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/editor+others/translator+others}%
  \setunit{\adddot\addspace}%
  \ifboolexpr{
    test {\ifnameundef{author}}
    and
    test {\ifnameundef{editor}}
  }
    {%
      \usebibmacro{title}%
      \setunit{\adddot\addspace}%
      \usebibmacro{date(online)}%
    }
    {%
      \usebibmacro{date(online)}%
      \setunit{\adddot\addspace}%
      \usebibmacro{title}%
    }%
  \setunit{\adddot\addspace}%
  \printlist{language}%
  \setunit{\adddot\addspace}%
  \usebibmacro{byauthor}%
  \setunit{\adddot\addspace}%
  \usebibmacro{byeditor+others}%
  \setunit{\adddot\addspace}%
  \printfield{version}%
  \setunit{\adddot\addspace}%
  \printfield{note}%
  \setunit{\adddot\addspace}\newblock
  \iffieldundef{eventtitle}
    {}
    {%
      \printtext{Presented at\addspace}%
      \printfield{eventtitle}%
      \setunit{\addcomma\space}%
      \printfield{venue}%
    }%
  \setunit{\adddot\addspace}\newblock
  \printlist{organization}%
  \setunit{\adddot\addspace}%
  \iftoggle{bbx:eprint}
    {\usebibmacro{eprint}}
    {}%
  \setunit{\adddot\addspace}\newblock
  \usebibmacro{url+urldate}%
  \setunit{\adddot\addspace}%
  \usebibmacro{addendum+pubstate}%
  \setunit{\bibpagerefpunct}\newblock
  \usebibmacro{pageref}%
  \newunit\newblock
  \iftoggle{bbx:related}
    {\usebibmacro{related:init}%
     \usebibmacro{related}}
    {}%
  \usebibmacro{finentry}}

