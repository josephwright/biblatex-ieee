\ProvidesFile{ieee.bbx}[2026-11-04 v1.4g biblatex bibliography style]

% Load the standard style to avoid copy-pasting unnecessary material
\RequireBibliographyStyle{numeric-comp}

\newbibmacro*{bbx:savehash}{\savefield{fullhash}{\bbx@lasthash}}

% An option that carries through from author-year styles
\DeclareBibliographyOption[boolean]{dashed}[true]{%
  \ifstrequal{#1}{true}
    {\ExecuteBibliographyOptions{pagetracker}%
     \renewbibmacro*{bbx:savehash}{\savefield{fullhash}{\bbx@lasthash}}}
    {\renewbibmacro*{bbx:savehash}{}}}

% Alter settings that carry through from biblatex
\ExecuteBibliographyOptions{
  giveninits,
  minnames = 1,
  maxcitenames = 2,
  maxbibnames  = 6,
  sorting  = none,
  dashed = false,
  urldate = long,
}
\uspunctuation
% Page numbers with a letter prefix get "pp." as well
% Example: "Phys. Rev., vol. 134, pp. A635--A646, Dec. 8, 1965."
\DeclareNumChars*{ABCDEFGHIJKLMNOPQRSTUVWXYZ}

% Load language-specific customizations
\DeclareLanguageMapping{magyar}{magyar-ieee}
% If more language-specific customizations besides magyar should get
% added, the above explicit mapping per language can be replaced with:
% \DeclareLanguageMappingSuffix{-ieee}

% Custom field formats
\DeclareFieldFormat{doi}{%
  doi\addcolon\space
  \ifhyperref
    {\href{https://doi.org/#1}{\nolinkurl{#1}}}
    {\nolinkurl{#1}}}
\DeclareFieldFormat[article]{number}{\bibstring{number}\addnbspace#1}
\DeclareFieldFormat[patent]{number}{\mkonepagegrouped{#1}}
\DeclareFieldFormat{pages}{%
  \mkpageprefix[bookpagination][\mkpagegrouped]{#1}%
}
\DeclareFieldFormat{sentencecase}{\bbx@colon@search{\MakeSentenceCase*}{#1}}
\DeclareFieldFormat[incollection,inproceedings]{series}
  {\bibstring{jourser}\addnbspace#1\isdot}
\DeclareFieldFormat[misc,online,report]{title}{\mkbibquote{#1\isdot}}
\DeclareFieldFormat[periodical]{title}{\mkbibemph{#1\isdot}}
\DeclareFieldFormat{howpublished}{#1\isdot}
\DeclareFieldFormat{booktitle}{\mkbibemph{#1\isdot}}
\DeclareFieldFormat{eventtitle}{#1\isdot}
\DeclareFieldFormat[manual]{sentencecase}{#1}
\DeclareFieldFormat{url}{\bibstring{url}\addcolon\space\url{#1}\nopunct}
\DeclareFieldFormat[video]{url}{\bibstring{urlvideo}\addcolon\space\url{#1}\nopunct}
% Example: "[PowerPoint slides]. Available: http://..."
\DeclareFieldFormat[online]{url}{%
  \iffieldundef{type}
    {\bibstring{url}}
    {[\printfield{type}]\adddot\addspace Available}%
  \addcolon\space\url{#1}\nopunct}
\DeclareFieldFormat[dataset]{title}{\mkbibquote{#1\isdot}}
% Example: "distributed by Harvard Election Data Archive,
% http://hdl.handle.net/1902.1/21919 UNF:5:5C9UfGjdLy2ONVPtgr45qA=="
\DeclareListFormat[dataset]{publisher}{%
  \ifnumequal{\value{listcount}}{1}
    {distributed by\addspace}
    {}%
  \usebibmacro{list:delim}{#1}%
  #1\isdot
  \usebibmacro{list:andothers}}
\DeclareFieldFormat[dataset]{url}{%
  \iflistundef{publisher}
    {\bibstring{url}\addcolon\space}
    {}%
  \url{#1}\nopunct}
\DeclareFieldFormat[dataset]{addendum}{%
  #1%
  \ifboolexpr{test {\iffieldundef{url}} or not test {\iffieldundef{doi}}}
    {}
    {\nopunct}}
% Example: "presented at the IEEE Summer Power Meeting, ..., Paper 90 SM 690-0
% PWRS" and "in IEDM Tech. Dig., 1993, vol. 2, no. 8"
\DeclareFieldFormat[inproceedings]{number}{%
  \iffieldundef{eventtitle}
    {\bibstring{number}\addnbspace#1}
    {Paper\addnbspace#1}}
\DeclareFieldFormat[article,periodical]{part}{pt\adddot\addnbspace#1}
% Example: "(in Russian)"
\DeclareListWrapperFormat{language}{\mkbibparens{in\addspace#1}}
\DeclareFieldFormat{urldate}{\bibstring{urlseen}\space#1}
\DeclareFieldFormat*{volume}
  {\bibstring{volume}\addnbspace#1}
\DeclareFieldFormat[article,periodical]{volume}
  {\bibstring{jourvol}\addnbspace#1}
\DeclareFieldFormat[article]{eid}{\bibstring{artno}\addnbspace#1}

% Simple modifications to punctuation, etc.
\renewcommand*\bibnamedash{\textemdash\textemdash}
\renewcommand*\intitlepunct{\addspace}
\renewcommand*\newunitpunct{\addcomma\addspace}

% Bibliography strings
\NewBibliographyString{artno}
\NewBibliographyString{patentjp}
\NewBibliographyString{presentedat}
\NewBibliographyString{standard}
\NewBibliographyString{urlvideo}

\DefineBibliographyStrings{english}{
  artno       = Art\adddot\addspace no\adddot      ,
  chapter     = ch\adddot                          ,
  editor      = Ed\adddot                          ,
  editors     = Eds\adddot                         ,
  mathesis    = M\adddot S\adddot\addspace thesis  ,
  patentjp    = Japanese Patent                    ,
  patentus    = U\adddot S\adddot\addspace Patent  ,
  phdthesis   = Ph\adddot D\adddot\addspace dissertation,
  presentedat = presented at the\addspace          ,
  standard    = Standard                          ,
  techreport  = Tech\adddot\addspace Rep\adddot    ,
  url         = [Online]\adddot\addspace Available ,
  urlvideo    = [Online Video]\adddot\addspace Available ,
  forthcoming = to be published                    ,
  submitted   = submitted for publication          ,
  urlseen     = Accessed\addcolon
}

\DefineBibliographyStrings{english}{
  june      = Jun\adddot ,
  july      = Jul\adddot ,
  september = Sep\adddot ,
}

% Support for dashed author name replacement
\InitializeBibliographyStyle{\global\undef\bbx@lasthash}


% Bibliography macros
\renewbibmacro*{author}{%
  \ifboolexpr{
    test \ifuseauthor
    and
    not test {\ifnameundef{author}}
  }
    {%
      \iffieldequals{fullhash}{\bbx@lasthash}
        {\bibnamedash\addcomma\space}
        {\printnames{author}}%
      \usebibmacro{bbx:savehash}%
      \iffieldundef{authortype}
        {}
        {%
          \setunit{\addcomma\space}%
          \usebibmacro{authorstrg}%
        }%
    }
    {\global\undef\bbx@lasthash}%
}

\renewbibmacro*{bybookauthor}{%
  \ifnamesequal{author}{bookauthor}
    {}
    {%
      \iffieldundef{bookauthor}
        {}
        {%
          \printnames{bookauthor}%
          \newunit
       }%
    }%
}

\renewbibmacro*{byeditor+others}{%
  \ifnameundef{editor}
    {}
    {%
      \usebibmacro{editor}%
      \setunit{\addspace}%
      \printnames[byeditor]{editor}%
      \clearname{editor}%
      \newunit
    }%
  \usebibmacro{byeditorx}%
  \usebibmacro{bytranslator+others}%
}

\renewbibmacro*{doi+eprint+url}{%
  \setunit{\addcomma\space}%
  \iftoggle{bbx:doi}
    {\printfield{doi}}
    {}%
  \setunit{\adddot\addspace}%
  \iftoggle{bbx:eprint}
    {\usebibmacro{eprint}}
    {}%
  \setunit{\adddot\addspace}%
  \iftoggle{bbx:url}
    {\usebibmacro{url+urldate}}
    {}%
}

\renewbibmacro*{event+venue+date}{%
  \iffieldundef{eventtitle}
    {}
    {%
      \bibstring{presentedat}%
      \printfield{eventtitle}%
    }%
  % Example: "presented at the 32nd ESA Antenna Workshop, Noordwijk, The
  % Netherlands, Oct. 5--8, 2010"
  \newunit
  \printfield{venue}%
  \newunit
  % The event date replaces the publication date, which would repeat the year
  \iffieldundef{eventyear}
    {}
    {%
      \printeventdate
      \clearfield{year}%
      \clearfield{month}%
      \clearfield{day}%
    }%
  \newunit
}

% Example: "Tokyo: Nihon Keizai Hyoronsha (in Japanese), 2000"
\renewbibmacro*{publisher+location+date}{%
  \printlist{location}%
  \iflistundef{publisher}
    {\setunit*{\addcomma\space}}
    {\setunit*{\addcolon\space}}%
  \printlist{publisher}%
  \ifboolexpr{
    not test {\iflistundef{language}}
    and (
      test {\ifentrytype{book}}
      or
      test {\ifentrytype{inbook}}
      or
      test {\ifentrytype{incollection}}
    )
  }
    {%
      \setunit*{\addspace}%
      \printlist{language}%
    }
    {}%
  \setunit*{\addcomma\space}%
  \usebibmacro{date}%
  \newunit
}

% Example: "(Nov. 2006)"; "year = {n.d.}" gives "(n.d.)"
\newbibmacro*{date(online)}{%
  \iffieldundef{year}
    {}
    {\printtext[parens]{\usebibmacro{date}}}%
}

\newbibmacro*{institution+location}{%
  \printlist{institution}%
  \newunit
  \printlist{location}%
  \newunit
}

\renewbibmacro*{institution+location+date}{%
  \printlist{institution}%
  \newunit
  \printlist{location}%
  \newunit
  \usebibmacro{date}%
  \newunit
}

\renewbibmacro*{issue+date}{%
  % An empty \printtext would still print the pending punctuation
  \ifboolexpr{
    test {\iffieldundef{issue}}
    and
    test {\iffieldundef{year}}
  }
    {}
    {%
      \printtext{%
        \iffieldundef{issue}
          {\usebibmacro{date}}
          {%
            \printfield{issue}%
            \setunit*{\addspace}%
            \usebibmacro{date}%
          }%
      }%
    }%
  \newunit
  \usebibmacro{issue}%
  \newunit
}

\renewbibmacro*{journal}{%
  \iffieldundef{shortjournal}
    {%
      \iffieldundef{journaltitle}
        {}
        {%
          \printtext[journaltitle]{%
          \printfield[titlecase]{journaltitle}%
          \setunit{\subtitlepunct}%
          \printfield[titlecase]{journalsubtitle}%
          }%
        }%
    }
    {%
      \printtext[journaltitle]{%
      \printfield[titlecase]{shortjournal}%
      }%
    }%
  \midsentence
}


\renewbibmacro*{journal+issuetitle}{%
  \usebibmacro{journal}%
  \newunit
  \iffieldundef{series}
    {}
    {%
      \newunit
      \printfield{series}%
      \newunit
    }%
  \usebibmacro{volume+number}%
  \setunit{\addspace}%
}

\renewbibmacro*{maintitle+booktitle}{%
  \iffieldundef{maintitle}
    {%
      \usebibmacro{booktitle}%
      \newunit
    }%
    {%
      \usebibmacro{maintitle}%
      \newunit\newblock\midsentence
      \usebibmacro{in:}%
      \printfield[titlecase]{booktitle}
      \newunit
    }%
}

\newbibmacro*{maintitle+booktitle(inproceedings)}{%
  \iffieldundef{maintitle}
    {%
      \iffieldundef{booktitle}
        {}
        {%
          \usebibmacro{in:}%
          \usebibmacro{maintitle+booktitle}%
          \clearfield{eventtitle}%
        }%
    }
    {%
      \usebibmacro{in:}%
      \usebibmacro{maintitle+booktitle}%
      \clearfield{eventtitle}%
    }%
}

\renewbibmacro*{maintitle+title}{%
  \iffieldsequal{maintitle}{title}
    {%
      \clearfield{maintitle}%
      \clearfield{mainsubtitle}%
      \clearfield{maintitleaddon}%
    }
    {%
      \iffieldundef{maintitle}
        {}
        {%
          \usebibmacro{maintitle}%
          \newunit\newblock
        }%
    }%
  \usebibmacro{title-in-maintitle}%
  \newunit
}

\newbibmacro*{pages}{%
  \setunit{\bibpagespunct}%
  \printfield{pages}%
}

\newbibmacro*{eid}{%
  \printfield{eid}
}

\newbibmacro*{series+number(book)}{%
  \iffieldundef{series}{}
    {%
      \setunit{\addspace}%
      \printtext[parens]{%
        \printfield{series}%
        \setunit*{\addspace}%
        \printfield{number}%
        \newunit}}}

\renewbibmacro*{title}{%
  \ifboolexpr{
    test {\iffieldundef{title}}
    and
    test {\iffieldundef{subtitle}}
  }
    {}
    {%
      \printtext[title]{%
        \printfield[sentencecase]{title}%
        \setunit{\subtitlepunct}%
        \printfield[sentencecase]{subtitle}%
      }%
      \newunit
    }%
  \printfield{titleaddon}%
}

\newbibmacro*{title-in-maintitle}{%
  \ifboolexpr{
    test {\iffieldundef{title}}
    and
    test {\iffieldundef{subtitle}}
  }
    {}
    {%
      \printtext[title]{%
        \printfield[titlecase]{title}%
        \setunit{\subtitlepunct}%
        \printfield[titlecase]{subtitle}%
      }%
      \newunit
    }%
  \printfield{titleaddon}%
}

\renewbibmacro*{url+urldate}{%
  \usebibmacro{urldate}%
  \setunit{\adddot\addspace}%
  \usebibmacro{url}%
}

\renewbibmacro*{urldate}{%
    \printurldate
    \newunit
  }

\newbibmacro*{volume+number}{%
  \printfield{volume}%
  \newunit
  \printfield{part}%
  \newunit
  \printfield{number}%
}

\newbibmacro*{volume+number+edition(inproceedings)}{%
  \usebibmacro{volume+part}%
  \newunit
  \printfield{number}%
  \newunit
  \printfield{edition}%
  \newunit
}

\newbibmacro*{volume+part}{%
  \iffieldundef{volume}
    {}
    {%
      \printfield{volume}%
      \printfield{part}%
      \setunit{\addcolon\space}%
    }%
}

% Punctuation before the city/publisher block of a book chapter (IEEE
% Reference Guide, 2025): a comma after the editor, a period after anything
% else (title, series, edition, volume).
% Example: "J. S. Brake, Ed., New York, NY, USA: Wiley"
% Example: "J. Peters, Ed., 2nd ed. New York, NY, USA: McGraw-Hill"
% Example: "Robot Vision. Cambridge, MA, USA: MIT Press"
% byeditor+others clears the editor list, so remember it beforehand.
\newtoggle{bbx:incollection:editor}
\newtoggle{bbx:inproceedings:editor}
\newbibmacro*{publisher+location+date(incollection)}{%
  \ifboolexpr{
    test {\iflistundef{location}}
    and
    test {\iflistundef{publisher}}
  }
    {\newunit}
    {%
      \ifboolexpr{
        togl {bbx:incollection:editor}
        and test {\iffieldundef{edition}}
        and (
          not test {\iffieldundef{maintitle}}
          or ( test {\iffieldundef{volume}} and test {\iffieldundef{part}} )
        )
        and test {\iffieldundef{volumes}}
        and test {\iffieldundef{note}}
      }
        {\newunit}
        {\setunit{\adddot\addspace}}%
    }%
  \newblock
  \usebibmacro{publisher+location+date}%
}

% Example: "IEEE Standard 802.11" (IEEE Reference Guide)
% Example: "NCITS Working Draft Proposed Standard 5.2"
\newbibmacro*{organization+type+number(standard)}{%
  \iflistundef{organization}
    {\printlist{institution}}
    {\printlist{organization}}%
  \setunit*{\addspace}%
  \iffieldundef{type}
    {%
      \iffieldundef{number}
        {}
        {\printtext{\bibcpstring{standard}}}%
    }
    {\printfield{type}}%
  \setunit*{\addspace}%
  \printfield{number}%
}

\newbibmacro*{organization+location+date(misc)}{%
  \printlist{organization}%
  \newunit
  \printlist{location}%
  \newunit
  \usebibmacro{date}%
  \newunit
}

% Specialised functions for manipulating data, where the biblatex
% kernel does not provide a suitable function.
\newcommand*{\mkpagegrouped}[1]{%
  \mkpagegrouped@aux#1\bibrangedash&%
}

\newcommand*{\mkpagegrouped@aux}{}
\def\mkpagegrouped@aux#1\bibrangedash#2&{%
  \mkonepagegrouped{#1}%
  \ifblank{#2}
    {}
    {%
      \bibrangedash
      \mkpagegrouped@second#2&%
    }%
}

\newcommand*{\mkonepagegrouped}[1]{%
  \ifinteger{#1}
    {%
      \mkpagegrouped@ifmorethanfour{#1}
        {\mkpagegrouped@separate{}#1\@empty\@empty\@empty}
        {#1}%
     }
     {#1}%
}

\newcommand*{\mkpagegrouped@second}{}
\def\mkpagegrouped@second#1\bibrangedash&{%
  \mkpagegrouped@second@auxi#1\bibrangessep&%
}

\newcommand*{\mkpagegrouped@second@auxi}{}
\def\mkpagegrouped@second@auxi#1\bibrangessep#2&{%
   \mkonepagegrouped{#1}%
   \ifblank{#2}
     {}
     {%
       \bibrangessep
       \mkpagegrouped@second@auxii#2&%
     }%
}

\newcommand*{\mkpagegrouped@second@auxii}{}
\def\mkpagegrouped@second@auxii#1\bibrangessep&{%
  \mkpagegrouped{#1}%
}

\newcommand*{\mkpagegrouped@ifmorethanfour}[1]{%
  \mkpagegrouped@ifmorethanfour@aux#1\@empty\@empty\@empty\@empty
    \@empty\@nil
}

\newcommand*{\mkpagegrouped@ifmorethanfour@aux}{}
\def\mkpagegrouped@ifmorethanfour@aux#1#2#3#4#5\@nil{%
 \ifx\@empty#5\@empty
   \expandafter\@secondoftwo
  \else
    \expandafter\@firstoftwo
  \fi
}

\newcommand*{\mkpagegrouped@separate}[4]{%
  \ifx\@empty#2\@empty
    \mkpagegrouped@print#1\relax
  \else
    \ifx\@empty#3\@empty
      \mkpagegrouped@print\@empty\@empty#1#2\relax
    \else
      \ifx\@empty#4\@empty
        \mkpagegrouped@print\@empty#1#2#3\relax
      \else
        \mkpagegrouped@separate@aux{#1#2#3#4}%
      \fi
    \fi
  \fi
}

\newcommand*{\bbx@digits@separate@aux}{}
\def\mkpagegrouped@separate@aux#1\fi\fi\fi{%
  \fi\fi\fi\mkpagegrouped@separate{#1}%
}

\newcommand*{\mkpagegrouped@print}[4]{%
  \ifblank{#1}{}{#1}%
  #2#3%
  \ifx#4\relax
  \else
    \addnbthinspace
    \expandafter\mkpagegrouped@print\expandafter#4%
  \fi
}

% \bbx@ifparen{<field>}{<true>}{<false>}: does the field start with "("?
% Example: "U.S. Reports, vol. 277, 1928, p. 478 (Justice Brandeis, dissenting)."
\newcommand*{\bbx@ifparen}[1]{%
  \expandafter\let\expandafter\bbx@tmp\csname abx@field@#1\endcsname
  \expandafter\bbx@ifparen@aux\bbx@tmp\relax\@nil
}
\def\bbx@ifparen@aux#1#2\@nil{%
  \ifx(#1%
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
}
\newbibmacro*{note+paren}{%
  \bbx@ifparen{note}{\setunit{\addspace}}{}%
  \printfield{note}%
}
\newbibmacro*{addendum+paren}{%
  \bbx@ifparen{addendum}{\setunit{\addspace}}{}%
  \printfield{addendum}%
}

% {<process>} {<text>}
\newcommand*{\bbx@colon@search}[2]{%
  \bbx@colon@search@auxi\empty#2: \stop{#1}%
}
\long\def\bbx@colon@search@auxi#1: #2\stop#3{%
  \expandafter\bbx@colon@search@auxii\expandafter{#1}{#3}%
  \ifblank{#2}
    {}
    {%
      : %
      \bbx@colon@search@auxi\empty#2\stop{#3}%
    }%
}
\newcommand\bbx@colon@search@auxii[2]{#2{#1}}

% New bibliography drivers, using the required order of fields. These
% are mainly copied from standard.bbx then modified.
\DeclareBibliographyDriver{article}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/translator+others}%
  \newunit
  \usebibmacro{title}%
  \newunit
  \printlist{language}%
  \newunit\newblock
  \usebibmacro{byauthor}%
  \newunit\newblock
  \usebibmacro{bytranslator+others}%
  \newunit\newblock
  \printfield{version}%
  \newunit\newblock
  \usebibmacro{journal+issuetitle}%
  \newunit
  % Example: "IEEE Trans. Antennas Propag., to be published."
  % Example: "IEEE Commun. Lett., early access, Dec. 11, 2018, doi: ..."
  \printfield{pubstate}%
  \newunit
  \usebibmacro{byeditor+others}%
  \newunit
  \usebibmacro{pages}%
  \newunit
  \usebibmacro{issue+date}%
  \newunit
  \usebibmacro{eid}
  \newunit
  \usebibmacro{note+paren}%
  \newunit\newblock
  \iftoggle{bbx:isbn}
    {\printfield{issn}}
    {}%
  \newunit\newblock
  \usebibmacro{doi+eprint+url}%
  \newunit\newblock
  \usebibmacro{addendum+paren}%
  \setunit{\bibpagerefpunct}\newblock
  \usebibmacro{pageref}%
  \newunit\newblock
  \iftoggle{bbx:related}
    {\usebibmacro{related:init}%
     \usebibmacro{related}}
    {}%
  \usebibmacro{finentry}}

\DeclareBibliographyDriver{book}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/editor+others/translator+others}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{maintitle+title}%
  \usebibmacro{series+number(book)}%
  \printfield{edition}%
  \newunit\newblock
  \usebibmacro{byauthor}%
  \newunit\newblock
  \usebibmacro{byeditor+others}%
  \newunit\newblock
  \printfield{volumes}%
  \newunit\newblock
  \setunit{\adddot\addspace}%
  \newblock
  \usebibmacro{publisher+location+date}%
  \newunit\newblock
  \usebibmacro{volume+part}%
  \newunit
  \usebibmacro{chapter+pages}%
  \newunit
  \printfield{pagetotal}%
  \newunit\newblock
  \printfield{note}%
  \newunit\newblock
  \iftoggle{bbx:isbn}
    {\printfield{isbn}}
    {}%
  \newunit\newblock
  \usebibmacro{doi+eprint+url}%
  \newunit\newblock
  \usebibmacro{addendum+pubstate}%
  \setunit{\bibpagerefpunct}\newblock
  \usebibmacro{pageref}%
  \newunit\newblock
  \iftoggle{bbx:related}
    {\usebibmacro{related:init}%
     \usebibmacro{related}}
    {}%
  \usebibmacro{finentry}}

\DeclareBibliographyDriver{inbook}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/translator+others}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \newunit
  \usebibmacro{byauthor}%
  \newunit\newblock
  \ifboolexpr{
    test {\iffieldundef{booktitle}}
    and
    test {\iffieldundef{maintitle}}
    and
    test {\ifnameundef{bookauthor}}
  }
    {}
    {\usebibmacro{in:}}%
  \usebibmacro{bybookauthor}%
  \usebibmacro{maintitle+booktitle}%
  \usebibmacro{series+number(book)}%
  \usebibmacro{byeditor+others}%
  \newunit\newblock
  \printfield{edition}%
  \newunit
  \printfield{volumes}%
  \newunit\newblock
  \setunit{\adddot\addspace}%
  \newblock
  \usebibmacro{publisher+location+date}%
  \newunit\newblock
  \usebibmacro{volume+part}%
  \newunit
  \usebibmacro{chapter+pages}%
  \newunit\newblock
  \printfield{note}%
  \newunit\newblock
  \iftoggle{bbx:isbn}
    {\printfield{isbn}}
    {}%
  \newunit\newblock
  \usebibmacro{doi+eprint+url}%
  \newunit\newblock
  \usebibmacro{addendum+pubstate}%
  \setunit{\bibpagerefpunct}\newblock
  \usebibmacro{pageref}%
  \newunit\newblock
  \iftoggle{bbx:related}
    {\usebibmacro{related:init}%
     \usebibmacro{related}}
    {}%
  \usebibmacro{finentry}}

\DeclareBibliographyDriver{incollection}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/translator+others}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \newunit
  \usebibmacro{byauthor}%
  \newunit\newblock
  \usebibmacro{in:}%
  \usebibmacro{maintitle+booktitle}%
  \newunit\newblock
  \usebibmacro{series+number}%
  \newunit\newblock
  \ifnameundef{editor}
    {\togglefalse{bbx:incollection:editor}}
    {\toggletrue{bbx:incollection:editor}}%
  \usebibmacro{byeditor+others}%
  \newunit\newblock
  \printfield{edition}%
  \newunit
  \iffieldundef{maintitle}
    {\printfield{volume}%
     \printfield{part}}
    {}%
  \newunit
  \printfield{volumes}%
  \newunit\newblock
  \printfield{note}%
  \usebibmacro{publisher+location+date(incollection)}%
  \newunit\newblock
  \usebibmacro{chapter+pages}%
  \newunit\newblock
  \iftoggle{bbx:isbn}
    {\printfield{isbn}}
    {}%
  \newunit\newblock
